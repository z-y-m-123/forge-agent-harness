# Comma-separated browser origins allowed to call this API.
FORGE_ALLOWED_ORIGINS=http://localhost:5173
HOST=127.0.0.1

# Optional: service-side default provider. BYOK requests do not use this key.
FORGE_PROVIDER=mock
# FORGE_MODEL_API_KEY=
# FORGE_MODEL_BASE_URL=https://api.deepseek.com/v1
# FORGE_MODEL_NAME=deepseek-chat

# Optional: required only for private GitHub repositories or higher rate limits.
# GITHUB_TOKEN=
# GITHUB_API_BASE_URL=https://api.github.com
