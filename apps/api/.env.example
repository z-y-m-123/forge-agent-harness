# Keep these values on the API server. Never put a provider key in the web app.
PORT=8787
# mock | deepseek | openai | anthropic | any OpenAI-compatible id
FORGE_PROVIDER=deepseek
FORGE_MODEL_API_KEY=replace-with-server-side-key
FORGE_MODEL_BASE_URL=https://api.deepseek.com/v1
FORGE_MODEL_NAME=deepseek-chat
